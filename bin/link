#!/bin/sh
# Symlinks every share folder's mods and layouts into the Herdr home.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
home=${HERDR_APP_HOME:-$HOME/.config/herdr-app}
link() {
  target="$home/$2"
  if [ -e "$target" ] && [ ! -L "$target" ]; then echo "skip $2: $target exists and is not a link" >&2; return; fi
  ln -sfn "$1" "$target"
  echo "linked $2"
}
for dir in "$repo"/*/mods/*/; do
  [ -d "$dir" ] || continue
  link "${dir%/}" "mods/$(basename "$dir")"
done
for file in "$repo"/*/layouts/*.json; do
  [ -e "$file" ] || continue
  link "$file" "layouts/$(basename "$file")"
done
